# Main bot token from @BotFather
BOT_TOKEN=your_bot_token_here

# Admin bot token (separate bot for notifications)
ADMIN_BOT_TOKEN=your_admin_bot_token_here

# Admin chat IDs (comma-separated) - get from admin bot /start
ADMIN_CHAT_IDS=123456789,987654321

# Admin bot webhook URL (e.g., https://admin-bot.railway.app/notify)
ADMIN_BOT_URL=https://your-admin-bot.railway.app/notify

# Timezone for shipping estimates
TIMEZONE=Europe/Riga

# Data file path (local development)
DATA_FILE=bookings.json

# Shipping configuration
SHIPPING_BASE_DAYS=3
SHIPPING_PER_COLOR_DAYS=1
SHIPPING_PER_SIZE_DAYS=1